# Copie este arquivo para .env.local e preencha com os seus valores.
# Onde achar: Supabase -> Project Settings -> API Keys (e Data API para a URL).

# Endereço do projeto Supabase, SÓ a base, sem "/rest/v1/" no final
# (ex.: https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (começa com sb_publishable_...). Pode ficar no navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# "teste" mostra o selo TESTE no rodapé. Use "oficial" no ambiente de verdade.
NEXT_PUBLIC_AMBIENTE=teste
